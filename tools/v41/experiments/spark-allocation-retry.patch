+        for (;;) {
+            cudaError_t allocation_error = cudaMalloc(&gp.c_stage[0], (size_t) gp.c_half + 1048576);
+            if (allocation_error == cudaSuccess)
+                allocation_error = cudaMalloc(&gp.c_stage[1], (size_t) gp.c_half + 1048576);
+            if (allocation_error == cudaSuccess) break;
+            (void) cudaGetLastError();
+            for (void*& stage : gp.c_stage) {
+                if (stage) cudaFree(stage);
+                stage = nullptr;
+            }
+            if (allocation_error != cudaErrorMemoryAllocation || gp.c_half <= stage_floor)
+                ck(allocation_error, "c_stage");
+            const int64_t next = std::max<int64_t>(stage_floor, gp.c_half / 2);
+            std::fprintf(stderr, "ds4_moe: chunk stage reduced from %.0f to %.0f MiB after allocation failure\n",
+                         (double) gp.c_half / 1048576.0, (double) next / 1048576.0);
+            gp.c_half = next;
+            gp.c_bhalf = std::min<int64_t>(gp.c_bhalf, gp.c_half);
+        }
         for (int h = 0; h < 2; ++h) {
             // + 1 MiB: the MMQ slot stride rounds a blob up (<= ~0.3 MiB) and MMQ reads up to 4 KiB past a matrix;
             // zeroed once, so whatever MMQ reads past a blob decodes to finite numbers (llama.cpp zero-pads too)
-            ck(cudaMalloc(&gp.c_stage[h], (size_t) gp.c_half + 1048576), "c_stage");
             ck(cudaMemset(gp.c_stage[h], 0, (size_t) gp.c_half + 1048576), "c_stage zero");
             // The bounce halves are PINNED host memory, and the arena's pin already takes all but ~4 GiB of the GPU's
             // shared-memory budget on Windows (WDDM): two 1 GiB halves can fail there ("c_bounce: out of memory" -
@@ -5131,20 +5154,55 @@ bool gpu_run_chunk(Ds41MoeImpl& im, int64_t layer, int n, const int32_t* ids, co
     if (use_mmq) {
         SL = MP.SL;
         const int64_t cap = std::max<int64_t>(16384, n);
-        if (use_mmq && gp.m_rows < cap) {
+        if (gp.m_rows < n || gp.m_rows == 0) {
             gp.free_mmq();
-            gp.m_rows = cap;
             const int64_t FF = GL.n_ff;
-            ck(cudaMalloc(&gp.m_gu, (size_t) cap * (size_t) (2 * FF) * 4), "m_gu");
-            ck(cudaMalloc(&gp.m_h, (size_t) cap * (size_t) FF * 4), "m_h");
-            ck(cudaMalloc(&gp.m_xg, mmq::q8_bytes(cap, H)), "m_xg");
-            ck(cudaMalloc(&gp.m_xu, mmq::q8_bytes(cap, H)), "m_xu");
-            ck(cudaMalloc(&gp.m_xd, mmq::q8_bytes(cap, FF)), "m_xd");
-            ck(cudaMalloc(&gp.m_bnd, sizeof(int32_t) * (size_t) (im.g.n_experts + 1)), "m_bnd");
-            ck(cudaMalloc(&gp.m_iota, sizeof(int32_t) * (size_t) (cap + 128)), "m_iota");   // + MMQ's id over-read (see c_dst)
-            mmq::iota((int32_t*) gp.m_iota, cap + 128, gp.s);
-            ds41_heapcheck("chunk:mmq-bufs", n);
-            if (!gp.m_ctx) gp.m_ctx = new mmq::Context();   // never deleted (see Gpu::m_ctx)
+            int64_t rows = cap;
+            for (;;) {
+                // A 16K-row warm allocation improves grouping but can exhaust
+                // Spark VRAM after the dense half grows. Each MMQ sub-run is
+                // already bounded by m_rows, so a smaller arena is equivalent.
+                cudaError_t allocation_error = cudaSuccess;
+                auto alloc = [&](void*& ptr, size_t bytes) {
+                    allocation_error = cudaMalloc(&ptr, bytes);
+                    return allocation_error == cudaSuccess;
+                };
+                const bool ready =
+                    alloc(gp.m_gu, (size_t) rows * (size_t) (2 * FF) * 4) &&
+                    alloc(gp.m_h, (size_t) rows * (size_t) FF * 4) &&
+                    alloc(gp.m_xg, mmq::q8_bytes(rows, H)) &&
+                    alloc(gp.m_xu, mmq::q8_bytes(rows, H)) &&
+                    alloc(gp.m_xd, mmq::q8_bytes(rows, FF)) &&
+                    alloc(gp.m_bnd, sizeof(int32_t) * (size_t) (im.g.n_experts + 1)) &&
+                    alloc(gp.m_iota, sizeof(int32_t) * (size_t) (rows + 128)); // MMQ id over-read
+                if (ready) {
+                    gp.m_rows = rows;
+                    mmq::iota((int32_t*) gp.m_iota, rows + 128, gp.s);
+                    break;
+                }
+                (void) cudaGetLastError();
+                gp.free_mmq();
+                if (allocation_error != cudaErrorMemoryAllocation)
+                    ck(allocation_error, "MMQ scratch allocation");
+                if (rows <= n) {
+                    // The existing grouped MMVQ path needs no MMQ scratch.
+                    // Retire MMQ for this class to avoid retrying every chunk.
+                    use_mmq = false;
+                    SL = BL;
+                    gp.m_ok[(size_t) CI] = 0;
+                    std::fprintf(stderr, "ds4_moe: MMQ scratch unavailable at %lld rows; using MMVQ for this class\n",
+                                 (long long) rows);
+                    break;
+                }
+                const int64_t next = std::max<int64_t>(n, rows / 2);
+                std::fprintf(stderr, "ds4_moe: MMQ scratch reduced from %lld to %lld rows after allocation failure\n",
+                             (long long) rows, (long long) next);
+                rows = next;
+            }
+            if (use_mmq) {
+                ds41_heapcheck("chunk:mmq-bufs", n);
+                if (!gp.m_ctx) gp.m_ctx = new mmq::Context(); // never deleted (see Gpu::m_ctx)
+            }
         }
     }
 #endif
