+        // A free-memory snapshot can overstate what WDDM will commit after
+        // another process grows. Both halves must fit; a smaller wave streams
+        // the same expert blobs in more passes. Never go below one blob.
+        const int64_t stage_floor = im.cfg.chunk_prestage
